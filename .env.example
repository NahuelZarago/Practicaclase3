# Configuración PÚBLICA del SDK web (Firebase Console → Configuración del proyecto → Tus apps → Web).
# Copiá este archivo a .env.local (ignorado por git) y completalo para `npm run build` en local.
# En `npm run dev` no hace falta: se usan los emuladores con un proyecto demo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
